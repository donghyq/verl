+            "actual_input_counter_status": "ARMED_NOT_YET_EXECUTED",
+            "actual_recomputed_tokens": 0,
+            "actual_processed_input_tokens": 0,
+            "actual_extend_input_tokens": 0,
+            "actual_decode_input_tokens": 0,
+            "actual_completed_forward_iters": [],

+
+    def manager(self, rank=0, running=None):
+        manager = object.__new__(snapshot.TokenKVSnapshotManager)
+        manager.scheduler = NS(ps=NS(tp_rank=rank, tp_size=2), running_batch=running)
+        parallel = patch.object(

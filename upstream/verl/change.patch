+def test_sglang_native_crossweight_requests(tmp_path):
+    if os.environ.get("VERL_RUN_SGLANG_PRESERVE_GPU") != "1":
+        pytest.skip("Opt-in: requires Linux default SGLang lock and three dedicated GPUs")

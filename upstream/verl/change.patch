+    result = run_gpu(tmp_path / "crossweight", tp=2)
+    assert result["status"] == "PASS_TINY_MOE_CROSSWEIGHT_PRESERVATION"
+    assert result["rollout_tp"] == 2 and len(result["ranks"]) == 2

+    if fault=='mamba_host_only':leaf.component_data[2].host_value=object()
+    if fault=='full_evicted':leaf.evicted=True
+    salt='other' if fault=='wrong_salt' else 'salt'
+    matched,_=probe.peek_complete_device_prefix(core,RadixKey(array('q',range(12)),cache_salt=salt))
+    assert matched==0
+

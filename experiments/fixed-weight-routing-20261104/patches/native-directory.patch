+async def test_native_probe_rejects_request_shapes_that_change_cache_matching(tmp_path,extra):
+    value=view();path=tmp_path/'view.json';path.write_text(json.dumps(value))
+    class NoQuery:
+        calls=[]
+        def query(self,payload):
+            self.calls.append(payload)
+            raise AssertionError('unsupported request must not query')
+        def close(self):pass
+    client=NoQuery()
+    advisor=V1KVRouteAdvisor({'mode':'shadow','view_path':str(path),'cache_context':CONTEXT,
+        'directory_source':'native_prefix_probe'},client=client,publication_client=Authority())
+    try:
+        result=await advisor.start({'input_ids':list(range(100)),**extra},policy_identity=IDENTITY,
+            cache_salt='observed-salt',allowed_urls=['http://replica-a','http://replica-b'])
+        assert result['status']=='fallback' and result['reason']=='native_probe_unsupported_request_shape'
+        assert client.calls==[]
+    finally:advisor.close()

+# Copyright 2026 Project B contributors
+# Licensed under the Apache License, Version 2.0.
+"""Request-bound GPU prefix metadata; no cache handles or state installation.
+
+The scheduler invokes this synchronously on its own control-message path.
+This first version supports FULL+MAMBA UnifiedTreeCore, device state only.
+"""
+from __future__ import annotations
+
+from array import array
+import hashlib
+import json
+import os
+import time
+
+
+def request_digest(tokens, cache_salt):
+    return hashlib.sha256(json.dumps({'token_ids': tokens, 'cache_salt': cache_salt},
+                                    sort_keys=True, separators=(',', ':')).encode()).hexdigest()
+
+
+def peek_complete_device_prefix(core, key):
+    """Observe existing full-node boundaries without native match's split/LRU/COW."""
+    if core.is_eagle or core.enable_hicache:
+        raise ValueError('directory v1 requires non-speculative device-only unified tree')
+    if core.has_ongoing_insert():
+        raise ValueError('cache insert is in progress')
+    if {int(component.component_type) for component in core.components} != {0, 2}:
+        raise ValueError('directory v1 requires exactly FULL and MAMBA components')
+    validators = tuple(c.create_match_validator(match_device_only=True) for c in core.components)
+    key = key.page_aligned(core.page_size)
+    node, consumed, complete, full_hit = core.root_node, 0, 0, 0
+    while len(key):
+        child = node.children.get(key.child_key(core.page_size))
+        if child is None or child.evicted:
+            break
+        matched = child.key.match(key, page_size=core.page_size)
+        if matched <= 0:
+            break
+        full_hit += matched
+        if matched < len(child.key):
+            # A hypothetical split has no Mamba state at this new boundary.
+            # Return the last existing boundary, without making the split.
+            break
+        consumed += matched
+        if all(validator(child) for validator in validators):
+            complete = consumed
+        key, node = key[matched:], child
+    return complete, full_hit
+
+
+def inspect_cache_prefix(manager, request, *, weight_version, key_factory=None):
+    if os.environ.get('SGLANG_ENABLE_NATIVE_CACHE_DIRECTORY') != '1':
+        raise ValueError('SGLANG_ENABLE_NATIVE_CACHE_DIRECTORY=1 is required')
+    query = request.cache_query
+    if not isinstance(query, dict) or set(query) - {
+            'token_ids', 'cache_salt', 'query_digest', 'expected_rank_generations'}:
+        raise ValueError('invalid request-bound cache query')
+    tokens, salt = query.get('token_ids'), query.get('cache_salt')
+    if (not isinstance(tokens, list) or not 1 <= len(tokens) <= 32768
+            or any(type(token) is not int or not 0 <= token < 2**31 for token in tokens)
+            or not isinstance(salt, str) or not 0 < len(salt) <= 256):
+        raise ValueError('bounded exact token IDs and explicit cache salt are required')
+    digest = request_digest(tokens, salt)
+    if query.get('query_digest') != digest:
+        raise ValueError('cache query does not match its token/salt identity')
+    if (not isinstance(weight_version, str) or not weight_version
+            or request.expected_weight_version != weight_version):
+        raise ValueError('actual engine weight version differs from requested version')
+    scheduler = manager.scheduler
+    cache = scheduler.tree_cache
+    if cache.__class__.__name__ != 'UnifiedRadixCache' or cache.disable:
+        raise ValueError('enabled native UnifiedRadixCache is required')
+    if getattr(scheduler.server_args, 'enable_lora', False):
+        raise ValueError('directory v1 does not support LoRA cache keys')
+    core = cache.tree_core
+    if key_factory is None:
+        from sglang.srt.mem_cache.radix_cache import RadixKey
+        key_factory = RadixKey
+    # Native scheduling retains the final input token for the next forward.
+    key = key_factory(array('q', tokens[:-1]), cache_salt=salt)
+    complete, full_hit = peek_complete_device_prefix(core, key)
+    generation = hashlib.sha256(json.dumps({
+        'engine_instance_id': manager.engine_instance_id,
+        'root_node_id': core.root_node.id,
+        'weight_version': weight_version,
+    }, sort_keys=True).encode()).hexdigest()
+    expected = query.get('expected_rank_generations')
+    rank = str(scheduler.ps.tp_rank)
+    if expected is not None and (not isinstance(expected, dict)
+            or set(expected) != {str(r) for r in range(scheduler.ps.tp_size)} or expected.get(rank) != {
+            'engine_instance_id': manager.engine_instance_id, 'cache_generation': generation}):
+        raise ValueError('stable target identity or cache generation changed')
+    # Only lengths and native identities leave the scheduler; no node/slot handles.
+    return {
+        'query_digest': digest, 'prompt_tokens': len(tokens), 'cache_salt': salt,
+        'actual_weight_version': weight_version, 'engine_instance_id': manager.engine_instance_id,
+        'cache_generation': generation, 'observed_at_unix': time.time(),
+        'native_full_kv_prefix': full_hit, 'native_complete_device_prefix': complete,
+        'rank_match': dict.fromkeys(('device', 'cpu_local', 'cpu_share', 'disk'), complete),
+        'running_requests': len(scheduler.running_batch.reqs),
+        'waiting_requests': len(scheduler.waiting_queue),
+        'coverage_source': 'native_read_only_full_mamba_tree',
+        'host_state_advertised': False, 'generation_admission_authorized': False,
+    }

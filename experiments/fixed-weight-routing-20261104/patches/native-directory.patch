+def native_response(payload,instance='a'):
+    q=payload['cache_query'];rows=[]
+    for rank in (0,1):
+        coverage=80 if rank==0 else 40
+        rows.append({'tp_rank':rank,'status':'PASS','query_digest':q['query_digest'],
+            'prompt_tokens':len(q['token_ids']),'cache_salt':q['cache_salt'],
+            'actual_weight_version':payload['expected_weight_version'],
+            'engine_instance_id':'native-'+instance+('-tp1' if rank else ''),
+            'cache_generation':('a' if instance=='a' else 'b')*64,'observed_at_unix':time.time(),
+            'native_complete_device_prefix':coverage,'rank_match':prefix(coverage),
+            'waiting_requests':0,'running_requests':0,'coverage_source':'native_read_only_full_mamba_tree',
+            'host_state_advertised':False,'generation_admission_authorized':False})
+    return {'status':'PASS','ranks':rows}
+

+def frozen_symbol(path, name):
+    tree=ast.parse(path.read_text())
+    node=next(n for n in ast.walk(tree) if isinstance(n,(ast.ClassDef,ast.FunctionDef)) and n.name==name)
+    future=ast.ImportFrom(module='__future__',names=[ast.alias(name='annotations')],level=0)
+    module=ast.fix_missing_locations(ast.Module(body=[future,node],type_ignores=[]))
+    namespace={'array':array}
+    exec(compile(module,str(path),'exec'),namespace)
+    return namespace[name]
+
+
+RadixKey=frozen_symbol(FROZEN/'radix_cache.py','RadixKey')
+FULL_VALIDATOR=frozen_symbol(FROZEN/'unified_cache/components/full_component.py','create_match_validator')
+MAMBA_VALIDATOR=frozen_symbol(FROZEN/'unified_cache/components/mamba_component.py','create_match_validator')
+
+
+def component(kind):
+    value=NS(component_type=kind)
+    value.create_match_validator=MethodType(FULL_VALIDATOR if kind==0 else MAMBA_VALIDATOR,value)
+    return value
+
+
+def node(tokens, *, mamba=True, full=True, salt='salt', identity=1):
+    return NS(id=identity,key=RadixKey(array('q',tokens),cache_salt=salt),children={},evicted=not full,
+              component_data={0:NS(value=object() if full else None,host_value=None),
+                              2:NS(value=object() if mamba else None,host_value=None)},last_access_time=10)
+
+
+def core_with_leaf(length=8195):
+    root=node([],identity=0);leaf=node(range(length));root.children[leaf.key.child_key(1)]=leaf
+    return NS(root_node=root,page_size=1,is_eagle=False,enable_hicache=False,
+              components=(component(0),component(2)),has_ongoing_insert=lambda:False),leaf
+
+
+def snapshot(core):
+    def walk(n):
+        return (n.id,tuple(n.key.token_ids),n.last_access_time,
+                tuple((k,id(v.value),id(v.host_value)) for k,v in n.component_data.items()),
+                tuple((repr(k),walk(v)) for k,v in n.children.items()))
+    return walk(core.root_node)
+
+
+def manager(core):
+    cache=type('UnifiedRadixCache',(),{})();cache.tree_core=core;cache.disable=False
+    return NS(engine_instance_id='native-a',scheduler=NS(tree_cache=cache,ps=NS(tp_rank=0,tp_size=2),
+              server_args=NS(enable_lora=False),running_batch=NS(reqs=[]),waiting_queue=[]))
+
+
+def query(tokens):
+    return NS(expected_weight_version='1',cache_query={'token_ids':tokens,'cache_salt':'salt',
+               'query_digest':native_query_digest(tokens,'salt')})

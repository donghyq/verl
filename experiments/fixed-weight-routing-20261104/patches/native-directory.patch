+@pytest.mark.parametrize('length,expected',[(8192,0),(8201,8195)])
+def test_exact_frozen_keys_and_component_validators_without_tree_or_lru_mutation(monkeypatch,length,expected):
+    monkeypatch.setenv('SGLANG_ENABLE_NATIVE_CACHE_DIRECTORY','1')
+    core,leaf=core_with_leaf();before=snapshot(core)
+    result=probe.inspect_cache_prefix(manager(core),query(list(range(length))),weight_version='1',key_factory=RadixKey)
+    assert result['native_complete_device_prefix']==expected
+    assert result['host_state_advertised'] is False and result['generation_admission_authorized'] is False
+    assert snapshot(core)==before
+    assert set(result)=={'query_digest','prompt_tokens','cache_salt','actual_weight_version','engine_instance_id',
+                         'cache_generation','observed_at_unix','native_full_kv_prefix','native_complete_device_prefix',
+                         'rank_match','running_requests','waiting_requests','coverage_source','host_state_advertised',
+                         'generation_admission_authorized'}
+

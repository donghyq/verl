+@pytest.mark.asyncio
+async def test_native_json_transport_full_rank_proof_shadow_call_and_publication_membership(tmp_path):
+    calls=[]
+    async def handler(request):
+        payload=await request.json();calls.append(payload)
+        instance=request.match_info['instance']
+        return web.json_response(native_response(payload,instance))
+    app=web.Application();app.router.add_post('/{instance}/token_kv_snapshot',handler)
+    runner=web.AppRunner(app);await runner.setup();site=web.TCPSite(runner,'127.0.0.1',0);await site.start()
+    port=site._server.sockets[0].getsockname()[1]
+    urls={key:f'http://127.0.0.1:{port}/{key}' for key in ('a','b')}
+    v=view()
+    for key in urls:
+        v['instances'][key]['engine_url']=urls[key]
+        # Global declarations intentionally disagree: native per-request data must win.
+        v['instances'][key]['hybrid_prefix_by_tp_rank']={'0':prefix(99),'1':prefix(99)}
+    path=tmp_path/'view.json';path.write_text(json.dumps(v))
+    class NativeAuthority(Authority):
+        async def get_active_published_policy(self):
+            record=await super().get_active_published_policy()
+            record['engine_observations']=[{'engine_url':url,'weight_version':'1','source':'model_info'} for url in urls.values()]
+            return record
+    advisor=V1KVRouteAdvisor({'mode':'shadow','view_path':str(path),'cache_context':CONTEXT,
+        'directory_source':'native_prefix_probe','native_instances':urls,'timeout_ms':100},publication_client=NativeAuthority())
+    try:
+        ticket=advisor.start({'input_ids':list(range(100))},policy_identity=IDENTITY,
+            cache_salt='observed-salt',allowed_urls=list(urls.values()))
+        result=await ticket
+        assert result['status']=='shadow_estimate'
+        assert {row['declared_device_prefix'] for row in result['candidates'].values()}=={40}
+        assert len(calls)==2 and all(c['operation']=='inspect_cache_prefix' for c in calls)
+        assert result['routing_changed'] is False
+        await advisor.observe(ticket,engine_url=urls['a'],worker_id='gateway-a',engine_instance_id='native-a')
+        assert advisor.records[-1]['actual_instance']=='a'
+        advisor.publication_client=Authority()  # Same policy, but observations cover another engine pool.
+        rejected=await advisor.start({'input_ids':list(range(100))},policy_identity=IDENTITY,
+            cache_salt='observed-salt',allowed_urls=list(urls.values()))
+        assert rejected['status']=='fallback' and len(calls)==2
+    finally:
+        advisor.close();await runner.cleanup()
+

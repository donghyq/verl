+@pytest.mark.parametrize('fault',['wrong_tokens','missing_rank','duplicate_rank','old_weight','rank_bool',
+                                  'missing_tier','host_claim','bad_generation','boolean_prefix'])
+def test_wire_proofs_cannot_be_replayed_or_incomplete(fault):
+    q={'token_ids':list(range(100)),'cache_salt':'salt','expected_weight_version':'1'}
+    payload={'expected_weight_version':'1','cache_query':{**q,'query_digest':native_query_digest(q['token_ids'],'salt')}}
+    response=native_response(payload)
+    if fault=='wrong_tokens':response['ranks'][1]['query_digest']='f'*64
+    if fault=='missing_rank':response['ranks'].pop()
+    if fault=='duplicate_rank':response['ranks'][1]['tp_rank']=0
+    if fault=='old_weight':response['ranks'][1]['actual_weight_version']='0'
+    if fault=='rank_bool':response['ranks'][1]['tp_rank']=True
+    if fault=='missing_tier':response['ranks'][1]['rank_match'].pop('disk')
+    if fault=='host_claim':response['ranks'][1]['host_state_advertised']=True
+    if fault=='bad_generation':response['ranks'][1]['cache_generation']='old'
+    if fault=='boolean_prefix':response['ranks'][1]['native_complete_device_prefix']=True
+    with pytest.raises(ValueError):validate_native_prefix_response(response,q,2)
+

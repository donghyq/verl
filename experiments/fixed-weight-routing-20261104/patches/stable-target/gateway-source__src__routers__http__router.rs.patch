+    fn select_stable_worker(
+        &self,
+        model_id: Option<&str>,
+        headers: Option<&HeaderMap>,
+    ) -> Result<Option<Arc<dyn Worker>>, Response> {
+        let worker_hint = headers.and_then(|h| h.get("x-smg-target-worker-id"));
+        let native_hint = headers.and_then(|h| h.get("x-sglang-native-target"));
+        if worker_hint.is_none() && native_hint.is_none() {
+            return Ok(None);
+        }
+        let error = |message: &str| {
+            error::create_error(
+                StatusCode::CONFLICT,
+                "native_target_rejected_before_admission",
+                message,
+            )
+        };
+        if worker_hint.is_none() || native_hint.is_none() {
+            return Err(error(
+                "stable worker ID and native target proof must both be present",
+            ));
+        }
+        let id = worker_hint
+            .unwrap()
+            .to_str()
+            .map_err(|_| error("invalid stable worker ID"))?;
+        if native_hint.unwrap().to_str().is_err() {
+            return Err(error("invalid native target proof header"));
+        }
+        let effective_model_id = if self.enable_igw { model_id } else { None };
+        let candidates = self.worker_registry.get_workers_filtered(
+            effective_model_id,
+            Some(WorkerType::Regular),
+            Some(ConnectionMode::Http),
+            None,
+            false,
+        );
+        select_registered_target(
+            Some(id),
+            self.stable_target_enabled,
+            |id| {
+                self.worker_registry
+                    .get(&WorkerId::from_string(id.to_owned()))
+            },
+            |worker| {
+                worker.is_available()
+                    && candidates
+                        .iter()
+                        .any(|candidate| Arc::ptr_eq(candidate, worker))
+            },
+        )
+        .map_err(|cause| error(&format!("stable worker target unavailable: {cause:?}")))
+    }

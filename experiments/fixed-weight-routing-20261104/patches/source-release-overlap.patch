+from test_trajectory_handoff_controller_on_cpu import (
+    FakeWorker, RemoteMethod, make_manager, make_runtime, start_mixed_source, wait_until,
+)
+from test_trajectory_publication_on_cpu import FakeQueue, MEMBERS, UID, original_tags
+from test_trajectory_shared_gpu_on_cpu import reclaim_manager, shared_trainer
+
+from verl.trainer.ppo.v1.trajectory_publication import publish_trajectory_group
+from verl.trainer.ppo.v1.trajectory_state import DurableTrajectoryCoordinator
+from verl.trainer.ppo.v1.trajectory_state.runtime import PromptGroupExecutionError
+from verl.trainer.ppo.v1.trajectory_handoff_controller import TrajectoryControlError
+from verl.trainer.ppo.v1.trainer_separate_async import HybridEngineMode
+from verl.workers.config.rollout import TrajectoryStateConfig
+
+HYBRID, STANDALONE = ["http://hybrid"], ["http://standalone"]
+
+
+def overlap_fields():
+    # Uniform CPU protocol fixture works with the host's TensorDict 0.7 too;
+    # it does not bypass the V1 runtime's >=0.10 ragged-construction guard.
+    rows = []
+    for index in range(8):
+        prompt, response = torch.tensor([101, 102]), torch.tensor([11, 12, 13])
+        rows.append(TensorDict({
+            "uid": NonTensorData(UID), "session_id": torch.tensor(index),
+            "prompts": prompt, "responses": response, "input_ids": torch.cat((prompt, response)),
+            "response_mask": torch.ones(3, dtype=torch.int64), "loss_mask": torch.ones(3, dtype=torch.int64),
+            "rollout_log_probs": torch.full((3,), -.2),
+        }, batch_size=[]))
+    return torch.stack(rows)
+
+
+def validate_overlap_fields(fields, members):
+    assert len(members) == 8 and list(fields.batch_size) == [8]
+    assert torch.equal(fields["session_id"], torch.arange(8))
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("fault", [None, "missing_release_proof", "persist_failed", "target_failed"])
+async def test_source_reclaim_does_not_wait_for_target_but_publication_does(tmp_path, fault):
+    coordinator = DurableTrajectoryCoordinator(str(tmp_path), "run")
+    source_task = None
+    target_release = asyncio.Event()
+    try:
+        source, target = make_runtime(coordinator), make_runtime(coordinator, owner="run/worker-1")
+        source_task, source_release = await start_mixed_source(source, uid=UID)
+        old_lease = source._groups[UID].members[2].lease
+        dispatched, paused, reopened = [], {}, []
+        queue = None
+
+        async def resume(handoff_id):
+            nonlocal queue
+            dispatched.append(handoff_id)
+
+            async def complete(index, *args):
+                await target_release.wait()
+                if fault == "target_failed":
+                    raise OSError("injected target execution failure")
+                return {"member_index": index}
+
+            result = await target.run_target(handoff_id, complete, complete)
+            assert [row["member_index"] for row in result.outputs] == list(range(8))
+
+            class QueueObservation:
+                calls = []
+
+                @property
+                def publication(self):
+                    return coordinator.get_publication(handoff_id)
+
+            queue = FakeQueue(QueueObservation())
+            return await publish_trajectory_group(
+                coordinator=target.client, handoff_id=handoff_id, members=MEMBERS,
+                fields=overlap_fields(), tags=original_tags(), partition_id="train",
+                validate_fields=validate_overlap_fields, tq_api=queue,
+            )
+
+        async def request(uid):
+            accepted = await source.request_preemption(uid)
+            source_release.set()
+            return accepted
+
+        workers = [
+            FakeWorker(request=request, status=source.group_status, resume=resume),
+            FakeWorker(request=lambda uid: False, status=target.group_status, resume=resume),
+        ]
+        for index, worker in enumerate(workers):
+            runtime = source if index == 0 else target
+            url = HYBRID[0] if index == 0 else STANDALONE[0]
+
+            def status(runtime=runtime, index=index, url=url):
+                return {"background_tasks": int(index == 0 and not source_task.done()),
+                        "active_groups": len(runtime._groups) + len(runtime._active_targets),
+                        "group_uids": list(runtime._groups), "cleanup_pending": 0, "errors": {},
+                        "source_engine_url": url, "resume_engine_url": url}
+
+            worker.trajectory_checkpoint_status = RemoteMethod(status)
+            worker.set_trajectory_checkpoint_paused = RemoteMethod(lambda flag, i=index: paused.update({i: flag}))
+            worker.resume_after_trajectory_reclaim = RemoteMethod(lambda i=index: reopened.append(i))
+        manager = make_manager(coordinator, workers)
+        manager._trajectory_reserved_target = 1
+        manager._trajectory_overlap_handoff = True
+        if fault == "persist_failed":
+            def fail_commit(handoff_id):
+                raise OSError("injected Manifest commit failure")
+            coordinator.commit_handoff_manifest = fail_commit
+            with pytest.raises(TrajectoryControlError):
+                await manager.prepare_trajectory_resource_reclaim(
+                    hybrid_engine_urls=HYBRID, standalone_engine_urls=STANDALONE, timeout_s=.1)
+            with pytest.raises(PromptGroupExecutionError, match="SOURCE_EXECUTION_FAILED"):
+                await source_task
+            assert dispatched == [] and queue is None
+            assert getattr(manager, "_trajectory_reclaim_receipt", None) is None
+            assert reopened == []
+            return
+        if fault == "missing_release_proof":
+            original_list = coordinator.list_recoverable_handoffs
+            coordinator.list_recoverable_handoffs = lambda: [
+                {k: v for k, v in row.items() if k not in {"source_released", "source_released_at"}}
+                for row in original_list()
+            ]
+            with pytest.raises(TrajectoryControlError):
+                await manager.prepare_trajectory_resource_reclaim(
+                    hybrid_engine_urls=HYBRID, standalone_engine_urls=STANDALONE, timeout_s=.1)
+            assert getattr(manager, "_trajectory_reclaim_receipt", None) is None
+            assert paused == {0: True, 1: True} and reopened == []
+            target_release.set()
+            await wait_until(lambda: bool(queue and queue.prompt_tag["status"] == "finished"))
+            return
+
+        receipt = await manager.prepare_trajectory_resource_reclaim(
+            hybrid_engine_urls=HYBRID, standalone_engine_urls=STANDALONE, timeout_s=2)
+        assert receipt["status"] == "quiesced" and receipt["target_completion_pending"] is True
+        await source_task
+        await wait_until(lambda: coordinator.summary()["active_execution_leases"] > 0)
+        assert coordinator.summary()["active_execution_leases_by_owner"] == {"run/worker-1": 6}
+        with pytest.raises(ValueError):
+            coordinator.check_trajectory_owner(old_lease)
+        assert queue is None and len(dispatched) == 1  # Incomplete group never published.
+        receipt["receipts"].append({"status": "forged"})
+        with pytest.raises(TrajectoryControlError, match="reclaim_not_quiesced"):
+            await manager.wait_trajectory_resource_reclaim_targets(receipt)
+        receipt["receipts"].pop()
+        with pytest.raises(TrajectoryControlError, match="reclaim_targets_unfinished"):
+            await manager.finish_trajectory_resource_reclaim(receipt)
+        with pytest.raises(TrajectoryControlError, match="reclaim_target_timeout"):
+            await manager.wait_trajectory_resource_reclaim_targets(receipt, timeout_s=.02)
+        assert (await manager.trajectory_operation_status(UID))["state"] == "dispatched"
+        assert len(dispatched) == 1 and reopened == []
+        target_release.set()
+        if fault == "target_failed":
+            with pytest.raises(TrajectoryControlError, match="reclaim_control_failed") as failed:
+                await manager.wait_trajectory_resource_reclaim_targets(receipt, timeout_s=2)
+            assert failed.value.__cause__.reason == "TARGET_EXECUTION_FAILED"
+            assert queue is None and reopened == [] and len(dispatched) == 1
+            return
+        await manager.wait_trajectory_resource_reclaim_targets(receipt, timeout_s=2)
+        assert queue.prompt_tag["status"] == "finished" and queue.put_calls == queue.prompt_put_calls == 1
+        assert list(coordinator.summary()["handoffs"].values()) == ["finished"]
+        await manager.finish_trajectory_resource_reclaim(receipt)
+        assert paused == {0: False, 1: False} and reopened == [0]
+        result = await manager.preempt_and_resume_trajectory(UID, target_worker_index=1, timeout_s=2)
+        assert result["status"] == "resumed" and len(dispatched) == 1
+    finally:
+        target_release.set()
+        if source_task is not None and not source_task.done():
+            source_task.cancel()
+            await asyncio.gather(source_task, return_exceptions=True)
+        coordinator.close()
+
+
+@pytest.mark.parametrize("fault", ["missing_topology", "target_on_hybrid", "unknown_source_lease", "policy_barrier"])
+def test_overlap_cannot_release_unconfirmed_sources(fault):
+    value, events = reclaim_manager()
+    value._trajectory_overlap_handoff = True
+    value.trajectory_worker_owner_ids = {"source": 0, "target": 1}
+    for index, worker in enumerate(value.agent_loop_workers):
+        original = worker.target.trajectory_checkpoint_status
+        url = HYBRID[0] if index == 0 or fault == "target_on_hybrid" else STANDALONE[0]
+        worker.target.trajectory_checkpoint_status = lambda original=original, url=url: {
+            **original(), "source_engine_url": url, "resume_engine_url": url}
+    value.trajectory_coordinator.target.summary = lambda: {
+        "active_execution_leases": int(fault == "unknown_source_lease"),
+        "active_execution_leases_by_owner": {"foreign-source": 1} if fault == "unknown_source_lease" else {},
+        "unsettled_publications": [], "handoffs": {},
+        "policy_publication_blocked": False, "handoff_policy_barrier": fault == "policy_barrier",
+    }
+    with pytest.raises(TrajectoryControlError):
+        value.prepare_trajectory_resource_reclaim(
+            hybrid_engine_urls=None if fault == "missing_topology" else HYBRID,
+            standalone_engine_urls=STANDALONE, timeout_s=.02)
+    assert value._trajectory_checkpoint_paused and "source-reopened" not in events
+    assert getattr(value, "_trajectory_reclaim_receipt", None) is None
+
+
+def overlap_trainer(*, target_fails=False):
+    value = shared_trainer()
+    value.config.actor_rollout_ref.rollout.trajectory_state.overlap_handoff_with_training = True
+    value.llm_server_manager = SimpleNamespace(server_addresses=HYBRID, _continuous_publication_client=lambda: None)
+    value.standalone_server_manager = SimpleNamespace(server_addresses=STANDALONE)
+
+    def prepare(**kwargs):
+        assert kwargs == {"hybrid_engine_urls": HYBRID, "standalone_engine_urls": STANDALONE}
+        assert value.events == ["remove", "native-routing-removed"]
+        value.events.append("source-released")
+        return {"status": "quiesced", "target_completion_pending": True}
+
+    def wait(receipt):
+        value.events.append("target-settled")
+        if target_fails:
+            raise TrajectoryControlError("reclaim_target_timeout")
+
+    value.agent_loop_manager.prepare_trajectory_resource_reclaim = prepare
+    value.agent_loop_manager.wait_trajectory_resource_reclaim_targets = wait
+    value.checkpoint_manager.install_same_version_weights = lambda *args: value.events.append("install-committed")
+    return value
+
+
+@pytest.mark.parametrize("target_fails", [False, True])
+def test_native_trainer_computes_before_target_wait_but_never_publishes_early(target_fails):
+    value = overlap_trainer(target_fails=target_fails)
+    value.switch_to_trainer()
+    assert value.current_mode is HybridEngineMode.TRAINER
+    assert value.events == ["remove", "native-routing-removed", "source-released", "hybrid_abort", "hybrid_sleep"]
+    value.events.append("actor-compute")
+    if target_fails:
+        with pytest.raises(TrajectoryControlError, match="reclaim_target_timeout"):
+            value.on_step_end()
+        assert value.standalone_checkpoint_manager.update_calls == []
+        assert "admission-reopened" not in value.events
+    else:
+        value.on_step_end()
+        assert value.events.index("actor-compute") < value.events.index("target-settled") < value.events.index("standalone_update")
+        assert value.events.index("install-committed") < value.events.index("admission-reopened")
+
+
+def test_overlap_config_is_opt_in_and_requires_bound_engines():
+    assert TrajectoryStateConfig().overlap_handoff_with_training is False
+    with pytest.raises(ValueError, match="overlapping handoff"):
+        TrajectoryStateConfig(overlap_handoff_with_training=True)
